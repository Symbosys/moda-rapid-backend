enum OrderStatusEnum {
  ORDER_PLACED
  ORDER_ACCEPTED
  PREPARING_ORDER
  READY_FOR_PICKUP
  PARTNER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id                       String            @id
  userId                   String
  storeId                  String
  addressId                String
  subtotal                 Decimal           @db.Decimal(10, 2)
  deliveryFee              Decimal           @db.Decimal(10, 2)
  platformFee              Decimal           @default(15.00) @db.Decimal(10, 2)
  tax                      Decimal           @db.Decimal(10, 2)
  discount                 Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount              Decimal           @db.Decimal(10, 2)
  paymentMethod            PaymentMethodType
  isPaid                   Boolean           @default(false)
  orderStatus              OrderStatusEnum   @default(ORDER_PLACED)
  estimatedDeliveryMinutes Int               @default(25)
  cancellationReason       String?           @db.VarChar(255)
  returnStatus             String?           @db.VarChar(255)
  placedAt                 DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user                     User              @relation(fields: [userId], references: [id])
  store                    Store             @relation(fields: [storeId], references: [id])
  deliveryAddress          Address           @relation(fields: [addressId], references: [id])
  items                    OrderItem[]
  payments                 Payment[]
  assignment               OrderAssignment?

  @@index([userId])
  @@index([storeId])
  @@index([orderStatus])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  productId   String
  variantId   String
  productName String         @db.VarChar(200)
  brand       String         @db.VarChar(100)
  size        String         @db.VarChar(20)
  color       String         @db.VarChar(50)
  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2)
  totalPrice  Decimal        @db.Decimal(10, 2)
  imageUrl    String         @db.VarChar(500)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}
